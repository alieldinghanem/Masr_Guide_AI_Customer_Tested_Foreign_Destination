# Recommended: Gemini Developer API, optional. Local planner runs without a key.
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only public, non-sensitive visitor questions on the free tier.
# Google Search may use a free quota and may be chargeable outside it.
GEMINI_SEARCH_GROUNDING=true

# Optional alternative, not required for the free Gemini flow.
# Leave blank to use the offline catalog preview; not an LLM.
# Select openai to route chat, hotel framing and trip-intent extraction through GPT.
# auto preserves legacy preference for Gemini when both keys are present.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=./data/tourism.db

# Safety guard for single-instance local demos (not a production replacement)
CHAT_RATE_LIMIT_PER_MINUTE=20

# Public portfolio preview without durable storage blocks account registration.
# APP_ENV=portfolio
# Never set this unless persistence and backup/recovery have actually been tested:
# MASR_DURABLE_STORAGE_CONFIRMED=true

# Required for APP_ENV=production ONLY after a successful restore drill.
# This flag does not perform or prove a backup. See COMPANY_RELEASE_GATE_AR.md.
# BACKUP_RECOVERY_VERIFIED=false
