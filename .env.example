# Google AI Studio free-tier key; no payment method required when free-tier access is available.
# Never publish or commit a real key. Check usage limits in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_GROUNDING=true

# Select openai to route chat, hotel framing and trip-intent extraction through GPT.
# auto preserves legacy preference for Gemini when both keys are present.
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo-only local rate limit; use an edge rate limiter for public traffic
CHAT_RATE_LIMIT_PER_MINUTE=20

# Runtime environment: portfolio for disposable public demos; production for durable service
# APP_ENV=portfolio
# Set these only after verifying persistent storage and backups:
# APP_ENV=production
# MASR_DURABLE_STORAGE_CONFIRMED=yes
# REQUIRE_CONDITIONAL_WRITES=true

# Free/ephemeral public preview disables account signup by default.
# MASR_DURABLE_STORAGE_CONFIRMED=true  # Only after proven durable storage/recovery

# Required for APP_ENV=production ONLY after a successful restore drill.
# This flag does not perform or prove a backup. See COMPANY_RELEASE_GATE_AR.md.
# BACKUP_RECOVERY_VERIFIED=false

# Google Identity Services (Sign in with Google). OAuth Web Client ID is public.
# Configure Authorized JavaScript Origins in Google Cloud for your exact site domain.
# Do NOT commit client secrets, token responses, or real database credentials.
GOOGLE_CLIENT_ID=
